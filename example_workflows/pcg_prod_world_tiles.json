   "widgets_values": [
    "hn = (@C - @C.min()) / (@C.max() - @C.min())\n@hn = hn\n# forest: on grassland, below the tree line (0.62), in patches\npatch = smoothstep(0.38, 0.62, noise(set(@u * 9, @v * 9, 1.7)))\nf = (1 - smoothstep(0.55, 0.68, hn)) * patch\n@Grass = @splat_grass * (1 - f)\n@ForestFloor = @splat_grass * f\n@Sediment = @splat_sediment\n@Rock = @splat_rock\n@Snow = @splat_snow\n@Water = @splat_water\n# scatter densities\n@d_tree = @ForestFloor\n@d_bush = @Grass * smoothstep(0.4, 0.7, noise(set(@u * 23, @v * 23, 5.3)))\n@d_rock = smoothstep(0.15, 0.5, @Rock) * (1 - 0.7 * @Rock) + 0.35 * @Sediment\n# terrain normal to world space (image x → world +X, image y (north) → world −Z, z → +Y)\n@tn = normalize(set(@N.x, @N.z, -@N.y))\n# colour for preview / minimap: lush and dry grass in patches, darker rock lower down, bluish water. Picked as\n# display (sRGB) values and made linear at the end (the minimap is written with an sRGB encode, the mesh preview\n# treats Cd as linear) -- without it everything came out pale lime\ndry = smoothstep(0.35, 0.7, noise(set(@u * 6, @v * 6, 4.4)) + 0.25 * hn)\ngrass = lerp(set(0.27, 0.34, 0.16), set(0.43, 0.42, 0.26), dry)\nrock = lerp(set(0.36, 0.34, 0.31), set(0.52, 0.50, 0.47), smoothstep(0.3, 0.8, hn))\nc = (grass * @Grass + set(0.19, 0.24, 0.12) * @ForestFloor + set(0.50, 0.45, 0.36) * @Sediment + rock * @Rock + set(0.90, 0.91, 0.94) * @Snow + set(0.13, 0.21, 0.25) * @Water)\n@albedo = (c * (0.92 + 0.16 * noise(set(@u * 60, @v * 60, 2.2)))) ** 2.2",
    0,
    "{}",
    0
   ],
