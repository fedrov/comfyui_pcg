   "widgets_values": [
    "# one large-scale mountain range: a thresholded low-frequency belt. Inside it the relief is a ridged multifractal\n# (crest lines where a noise crosses its middle value, each octave weighted by the one before) on domain-warped\n# coordinates -- sharp crests and branching spurs instead of round cones; erosion below then cuts the valleys\nm = smoothstep(0.42, 0.72, noise(set(@u * 2.2, @v * 2.2, 3.1)))\nw = set(@u * 5, @v * 5, 0.0) + 0.6 * (vnoise(set(@u * 2.5, @v * 2.5, 7.7)) - 0.5)\nr = 0\na = 0.5\nf = 1.0\nprev = 1\nfor i in range(5):\n    n = 1 - clamp(abs(noise(w * f + i * 3.3) - 0.5) * 3.5, 0, 1)\n    n = n * n * (0.4 + 0.6 * prev)\n    r = r + a * n\n    prev = n\n    a = a * 0.5\n    f = f * 2.1\n@C = @C * (0.6 + 0.6 * m) + m * (0.20 * r + 0.07 * m) - 0.02",
    0,
    "{}",
    0
   ],
   "title": "Mountain belt (ridged)"
  },
