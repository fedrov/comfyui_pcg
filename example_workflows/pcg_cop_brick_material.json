   "widgets_values": [
    "r = @pattern_rand\nd = @detail - 0.5\nbrick = lerp(set(0.50, 0.20, 0.13), set(0.70, 0.36, 0.22), r)\nbrick = where(r > 0.88, set(0.28, 0.14, 0.10), brick)   # 10% over-fired bricks\nbrick = brick * (0.9 + d * 0.5)\nbrick = brick + set(0.12, 0.10, 0.08) * clamp(@curvature, 0, 1)   # brighten worn convex edges\nmortar = set(0.60, 0.58, 0.54) * (0.9 + d * 0.4)\n@albedo = lerp(mortar, brick, @brick) * lerp(0.55, 1.0, @ao)\n@roughness = lerp(0.95, 0.72 + d * 0.3, @brick)",
