   "properties": {
    "Node name for S&R": "PCG_COPWrangle"
   },
   "widgets_values": [
    "d = @detail - 0.5\n# pixel distance to the brick edge plus noise perturbation; below the threshold counts as chipped off\nchip = smoothstep(3.0, 12.0, @pattern_edge + d * 36)\n@brick = chip\n# Crystal Noise cell borders = cracks (pits is close to 0 on the borders), only on about a third of the bricks\n# and fading out across each of those, so cracked bricks read as weathered rather than tiled\ncracked = smoothstep(0.5, 0.7, frac(@pattern_rand * 7.31)) * smoothstep(0.3, 0.5, @detail)\nface = @pattern_height * (0.85 + 0.15 * @pattern_rand) + d * 0.12 - (1 - @pits) * 0.03 * cracked\nmortar = 0.08 + d * 0.05\n@height = lerp(mortar, face, chip)",
    0,
    "{}",
    0
   ],
   "title": "Height + chipped edges"
  },
