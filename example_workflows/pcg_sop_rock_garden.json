   "widgets_values": [
    "point",
    "# the stone of each kind (class % 4, as the SDF's seed % 4): grey-brown boulder, buff slab, dark shard,\n# weathered grey block; mottled at the metre scale\nk = @class - 4 * floor(@class / 4)\nrock = where(k < 0.5, set(0.40, 0.37, 0.33), where(k < 1.5, set(0.52, 0.45, 0.35), where(k < 2.5, set(0.28, 0.28, 0.27), set(0.43, 0.42, 0.40))))\nrock = rock * (0.8 + 0.4 * noise(@P * 1.1)) * (0.9 + 0.2 * noise(@P * 6.0))\n# upward-facing faces × noise patches → moss\nm = smoothstep(0.55, 0.85, @N.y) * smoothstep(0.45, 0.62, noise(@P * 1.5))\n@Cd = lerp(rock, set(0.22, 0.27, 0.12), m)",
