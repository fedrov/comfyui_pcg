   "widgets_values": [
    "point",
    "d = @dstream\nsteep = smoothstep(0.06, 0.22, 1 - @N.y)\n# flat ground is grass, steep places show soil, the stream banks are gravel, the stream is water\n# grass varies between lush and dry in broad patches, plus a fine mottle\ndry = smoothstep(0.35, 0.65, noise(@P * 0.12 + 7.7)) * 0.7 + 0.3 * noise(@P * 1.3)\ngrass = lerp(set(0.20, 0.30, 0.11), set(0.36, 0.37, 0.18), dry)\n@Cd = lerp(grass, set(0.40, 0.32, 0.23), steep)\n@Cd = lerp(set(0.50, 0.46, 0.40), @Cd, smoothstep(1.2, 2.2, d))\n@Cd = lerp(set(0.10, 0.22, 0.30), @Cd, smoothstep(0.7, 1.0, d))\n# big rocks: gentle slope, inside noise patches, a bit away from the stream (appear in clusters, not scattered uniformly)\n@boulder = (1 - steep) * smoothstep(0.46, 0.56, noise(@P * 0.09 + 3.1)) * smoothstep(3.0, 4.5, d)\n# pebbles: stream banks\n@bank = smoothstep(0.7, 1.2, d) * (1 - smoothstep(1.8, 3.2, d))",
    "",
    0,
    "{}"
   ],
   "title": "Colour + scatter weights"
