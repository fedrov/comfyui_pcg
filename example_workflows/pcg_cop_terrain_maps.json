   "widgets_values": [
    "d = @C.x\ngrass = set(0.28, 0.38, 0.14) * (1 - 0.35 * clamp(@wetness, 0, 1))\nsed = set(0.55, 0.48, 0.36)\n# rock gets bands by height (sedimentary bedding)\nband = 0.5 + 0.5 * sin(d * 520)\nrock = lerp(set(0.42, 0.36, 0.31), set(0.58, 0.52, 0.45), band)\nsnow = set(0.92, 0.93, 0.96)\nwater = set(0.10, 0.22, 0.30)\nc = grass * @splat_grass + sed * @splat_sediment + rock * @splat_rock + snow * @splat_snow + water * @splat_water\n@albedo = c * lerp(0.6, 1.0, @ao)",
    0,
    "{}",
    0
   ],
   "title": "Mix colours from five layers"
